# units lj, case efield_single. Reference: ref.efield_single.thermo / ref.efield_single.dump (make_refs.sh).
units lj
atom_style full
read_data data.lmp
include system.ff
pair_modify table 0
kspace_modify gewald 1.30068 mesh 24 24 24 order 5
neighbor 0.3 bin
neigh_modify every 1 delay 0 check no
timestep 0.005
fix 2 all efield 0.3 -0.2 0.25
thermo_style custom step pe ke temp press pxx pyy pzz pxy pxz pyz evdwl ecoul elong ebond eangle edihed eimp etotal f_2
thermo_modify norm no format float %.17g
dump d all custom 1 ref.efield_single.dump id type fx fy fz
dump_modify d format float %.17g sort id
fix_modify 2 energy yes
run 0
