# units lj: LAMMPS style/coefficient commands (included by every in.*.lmp)
pair_style lj/cut/coul/long 2.5 2.5
pair_coeff 1 1 1.0 1.0
pair_coeff 1 2 0.75 0.95
pair_coeff 2 2 0.5 0.9
pair_modify shift yes
bond_style harmonic
bond_coeff 1 50.0 1.0
special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0
kspace_style pppm 1.0e-5
