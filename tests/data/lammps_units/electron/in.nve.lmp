# units electron, case nve. Reference: ref.nve.thermo / ref.nve.dump (make_refs.sh).
units electron
atom_style full
read_data data.lmp
include system.ff
neighbor 1.0 bin
neigh_modify every 1 delay 0 check no
timestep 2.0
fix 1 all nve
thermo_style custom step temp pe ke etotal press
thermo_modify norm no format float %.17g
thermo 10
dump d all custom 100 ref.nve.dump id type xu yu zu vx vy vz fx fy fz
dump_modify d format float %.17g sort id delay 1
run 100
