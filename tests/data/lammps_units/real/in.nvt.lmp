# units real, case nvt. Reference: ref.nvt.thermo / ref.nvt.dump (make_refs.sh).
units real
atom_style full
read_data data.lmp
include system.ff
pair_modify table 0
kspace_modify gewald 0.391294 mesh 15 15 15 order 5
neighbor 2.0 bin
neigh_modify every 1 delay 0 check no
timestep 1.0
fix 1 all nvt temp 300.0 300.0 100.0 tchain 1
thermo_style custom step temp pe ke etotal press econserve
thermo_modify norm no format float %.17g
thermo 10
dump d all custom 100 ref.nvt.dump id type xu yu zu vx vy vz fx fy fz
dump_modify d format float %.17g sort id delay 1
run 100
