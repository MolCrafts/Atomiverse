# Native atomiverse input — LJ argon, 4³ simple cubic (LAMMPS-shaped).
#   cmake --build build --target atomiverse_cli
#   ./build/app/atomiverse/atomiverse -in examples/in.lj
units metal
atom_style atomic
dimension 3
boundary p p p
lattice sc 4.0
region box block 0 16 0 16 0 16
create_box 1 box
create_atoms 1 box
mass 1 39.948
pair_style lj/cut 6.8
pair_coeff * * 0.0104 3.4
neighbor 0.5 bin
timestep 1.0
thermo 50
velocity all create 94.4 42
run 20
