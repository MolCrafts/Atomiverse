&CONTROL
 calculation='scf', prefix='h2o', pseudo_dir='./', outdir='./scratch',
 tprnfor=.true., tstress=.true., verbosity='high'
/
&SYSTEM
 ibrav=0, nat=3, ntyp=2, ecutwfc=12.0, ecutrho=48.0,
 nr1=72, nr2=72, nr3=72, nr1s=72, nr2s=72, nr3s=72,
 input_dft='pbe', occupations='fixed', nosym=.true., noinv=.true.
/
&ELECTRONS
 conv_thr=1.0d-12, electron_maxstep=200, mixing_beta=0.3,
 diagonalization='david', diago_thr_init=1.0d-12
/
ATOMIC_SPECIES
O 15.999 O_ONCV_PBE-1.2.upf
H 1.008 H_GTH_PBE_q1.gth
CELL_PARAMETERS angstrom
4.4 0.0 0.0
0.31 4.2 0.0
0.23 0.18 4.0
ATOMIC_POSITIONS angstrom
H 2.29 1.51 1.67
O 1.43 1.20 1.29
H 1.09 2.04 1.75
K_POINTS gamma
