&GLOBAL
  PROJECT si4_kpoints_mg
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 384
      NGRIDS 3
      REL_CUTOFF 96
      PROGRESSION_FACTOR 2
    &END MGRID
    &QS
      CORE_PPL GRID
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      EPS_PPNL 1.0E-12
      EPS_FILTER_MATRIX 0.0
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      SYMMETRY F
      FULL_GRID T
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-10
      EPS_DIIS 0.0
      MAX_SCF 200
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 7.255773194183833 7.255773194183833 10.261212856717933
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      Si 0.031 0.023 -0.017
      Si 3.6278865970919165 3.6278865970919165 5.130606428358966
      Si 3.6278865970919165 0 2.565303214179483
      Si 0 3.6278865970919165 7.6959096425384494
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES
    &END FORCES
    &STRESS_TENSOR
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
