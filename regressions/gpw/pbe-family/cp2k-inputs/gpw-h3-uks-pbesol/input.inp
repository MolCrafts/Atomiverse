&GLOBAL
 PROJECT h2_variant
 RUN_TYPE ENERGY_FORCE
 PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
 METHOD Quickstep
 STRESS_TENSOR NUMERICAL
 &DFT
  UKS
  MULTIPLICITY 2
  BASIS_SET_FILE_NAME ../BASIS_SET
  POTENTIAL_FILE_NAME ../GTH_POTENTIALS
  &MGRID
   CUTOFF 80
   NGRIDS 1
  &END MGRID
  &QS
   METHOD GPW
   CORE_PPL GRID
   EPS_DEFAULT 1.0E-10
   EPS_PGF_ORB 1.0E-10
   EPS_PPNL 1.0E-10
   EPS_FILTER_MATRIX 0.0
  &END QS
  &SCF
   SCF_GUESS ATOMIC
   EPS_SCF 1.0E-10
   EPS_DIIS 0.0
   MAX_SCF 200
   &DIAGONALIZATION
    ALGORITHM STANDARD
   &END DIAGONALIZATION
   &MIXING
    METHOD BROYDEN_MIXING
    ALPHA 0.5
    NBROYDEN 6
   &END MIXING
  &END SCF
  &XC
   &XC_FUNCTIONAL
    &GGA_X_PBE_SOL
    &END GGA_X_PBE_SOL
    &GGA_C_PBE_SOL
    &END GGA_C_PBE_SOL
   &END XC_FUNCTIONAL
   &XC_GRID
    XC_DERIV PW
    XC_SMOOTH_RHO NONE
   &END XC_GRID
  &END XC
  &POISSON
   PERIODIC XYZ
  &END POISSON
 &END DFT
 &SUBSYS
  &CELL
   ABC [bohr] 12 11 10
   PERIODIC XYZ
  &END CELL
  &COORD
   UNIT bohr
   H 2.267671349478074 2.0786987370215684 1.8897261245650618
   H 3.9684248615866302 3.0235617993040993 2.4566439619345806
   H 3.0235617993040993 4.2518837802713891 3.4015070242171115
  &END COORD
  &KIND H
   BASIS_SET DZV-GTH-PADE
   POTENTIAL GTH-PBE-q1
  &END KIND
 &END SUBSYS
 &PRINT
  &FORCES
  &END FORCES
  &STRESS_TENSOR
  &END STRESS_TENSOR
 &END PRINT
&END FORCE_EVAL
