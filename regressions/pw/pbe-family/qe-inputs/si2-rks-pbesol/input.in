&CONTROL
 calculation='scf', prefix='nc_extension_si2', pseudo_dir='./',
 outdir='./scratch', tprnfor=.true., tstress=.true., verbosity='high'
/
&SYSTEM
 ibrav=0, nat=2, ntyp=1, ecutwfc=12.0, ecutrho=48.0,
 nr1=40, nr2=40, nr3=40, nr1s=40, nr2s=40, nr3s=40,
 input_dft='pbesol', occupations='smearing', smearing='fermi-dirac',
 degauss=0.02, nspin=1, nbnd=6,
 nosym=.true., noinv=.true.
/
&ELECTRONS
 conv_thr=1.0d-11, electron_maxstep=200, mixing_beta=0.2,
 diagonalization='david', diago_thr_init=1.0d-12
/
ATOMIC_SPECIES
Si 28.0855 Si_GTH_PBE_q4.gth
CELL_PARAMETERS angstrom
6 0 0
0 6 0
0 0 6
ATOMIC_POSITIONS angstrom
Si 2 2 2
Si 3.8 3.2 3.0
K_POINTS gamma
