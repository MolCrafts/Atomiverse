! Fair-wall twin of regressions/pw/pw-pbe-gga-si, run 2 of 2 (local LDA).
! ATV's XCType::LSDA is Slater + PW92 -> QE input_dft='SLA PW'. No forces
! (the ATV regression computes forces only on the PBE run).
&control
  calculation = 'scf'
  prefix = 'si_lsda'
  pseudo_dir = '<ATV_CHECKOUT>/tests/data/pw'
  outdir = './out'
/
&system
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 15.0
  input_dft = 'SLA PW'
/
&electrons
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.0855 Si_lda_nc.upf
CELL_PARAMETERS angstrom
0.000 2.715 2.715
2.715 0.000 2.715
2.715 2.715 0.000
ATOMIC_POSITIONS angstrom
Si 0.0000 0.0000 0.0000
Si 1.3575 1.3575 1.3575
K_POINTS automatic
2 2 2 0 0 0
