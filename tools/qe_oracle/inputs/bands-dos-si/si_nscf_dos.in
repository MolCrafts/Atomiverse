! Fair-wall twin of regressions/pw/bands-dos-si, step 3 of 4: NSCF DOS mesh.
! ATV's Dos: MP 4x4x4 (unshifted, 64 k solved without reduction), 8 bands.
! QE reduces the mesh to its IBZ set natively.
&control
  calculation = 'nscf'
  prefix = 'si_bd'
  pseudo_dir = '<ATV_CHECKOUT>/tests/data/pw'
  outdir = './out'
/
&system
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 15.0
  nbnd = 8
  input_dft = 'SLA PW'
/
&electrons
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.0855 Si_lda_nc.upf
CELL_PARAMETERS angstrom
0.000 2.715 2.715
2.715 0.000 2.715
2.715 2.715 0.000
ATOMIC_POSITIONS angstrom
Si 0.0000 0.0000 0.0000
Si 1.3575 1.3575 1.3575
K_POINTS automatic
4 4 4 0 0 0
