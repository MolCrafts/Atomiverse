! Fair-wall twin of regressions/pw/bands-dos-si, step 2 of 4: NSCF bands.
! Exactly ATV's Bands::set_diamond_path(4) list: 16 crystal k-points on
! G-X-W-L-G-K (4 samples per leg, shared joins deduplicated), 8 bands.
&control
  calculation = 'bands'
  prefix = 'si_bd'
  pseudo_dir = '<ATV_CHECKOUT>/tests/data/pw'
  outdir = './out'
/
&system
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 15.0
  nbnd = 8
  input_dft = 'SLA PW'
/
&electrons
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.0855 Si_lda_nc.upf
