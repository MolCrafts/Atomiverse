! Fair-wall twin of regressions/pw/pw-uks-kmesh-fe, run 1 of 2 (spin-PBE).
! O2 triplet, fixed occupations M = 2, multi-k collinear UKS. Same SG15 ONCV
! PBE oxygen UPF, cubic L = 5.5 A cell, ecutwfc = 5 Ry (deliberately tiny —
! this is the regression's own cost class), MP 2x2x2. ATV solves all 8 k;
! QE reduces to its IBZ set natively.
&control
  calculation = 'scf'
  prefix = 'o2_pbe'
  pseudo_dir = '<ATV_CHECKOUT>/tests/data/pw'
  outdir = './out'
/
&system
  ibrav = 1
  A = 5.5
  nat = 2
  ntyp = 1
  ecutwfc = 5.0
  nspin = 2
  tot_magnetization = 2.0
  occupations = 'fixed'
  input_dft = 'PBE'
/
&electrons
  conv_thr = 1.0d-6
/
ATOMIC_SPECIES
O 15.999 O_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS angstrom
O 0.0 0.0 0.0
O 0.0 0.0 1.2075
K_POINTS automatic
2 2 2 0 0 0
