! Install-validation smoke (not a regression pin). See ../../pin_notes.md.
! pseudo_dir must point at the ATV checkout's tests/data/pw so pw.x consumes
! the exact ONCVPSP NC UPF the ATV PW regressions use.
&control
  calculation = 'scf'
  prefix = 'si'
  pseudo_dir = '<ATV_CHECKOUT>/tests/data/pw'
  outdir = './out'
/
&system
  ibrav = 2
  celldm(1) = 10.2612
  nat = 2
  ntyp = 1
  ecutwfc = 15.0
/
&electrons
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.0855 Si_lda_nc.upf
ATOMIC_POSITIONS alat
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25
K_POINTS automatic
2 2 2 0 0 0
