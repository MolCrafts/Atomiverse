# Offline pin twin: constant-force-pull-ion
# units metal; fix addforce on type-1 ion; pair zero; run 0 + short NVE.
# Metal time unit = ps; timestep 0.001 = 1 fs.
units metal
atom_style full
boundary p p p
region box block 0 20 0 20 0 20
create_box 2 box

create_atoms 1 single 10.0 10.0 5.0
create_atoms 2 single 10.0 10.0 15.0
mass 1 39.948
mass 2 39.948
set atom 1 charge 1.0
set atom 2 charge 0.0

group ion type 1
group bg type 2

pair_style zero 10.0
pair_coeff * *
neighbor 0.3 bin
neigh_modify every 1 delay 0 check no

variable Fz equal 0.05
fix 1 ion addforce 0.0 0.0 ${Fz}

velocity all set 0 0 0 units box
fix 2 all nve
timestep 0.001

compute zion ion reduce sum z
compute fzion ion reduce sum fz
compute fxion ion reduce sum fx
compute fyion ion reduce sum fy
compute fzbg bg reduce sum fz
compute zbg bg reduce sum z

thermo_style custom step pe ke etotal f_1 c_zion c_fxion c_fyion c_fzion c_fzbg c_zbg
thermo 1
dump 1 all custom 50 dump.addforce id type q x y z fx fy fz ix iy iz

run 0
print "GATE_A U_add=$(f_1) zion=$(c_zion) Fion=($(c_fxion),$(c_fyion),$(c_fzion)) Fzbg=$(c_fzbg) zbg=$(c_zbg)"

thermo 20
run 100
print "GATE_B U_add=$(f_1) zion=$(c_zion) Fion=($(c_fxion),$(c_fyion),$(c_fzion)) pe=$(pe) ke=$(ke) zbg=$(c_zbg)"
variable dz equal c_zion-5.0
variable W equal ${Fz}*v_dz
print "WORK_PROXY Fz*dz = ${W}  dz=${dz}"
