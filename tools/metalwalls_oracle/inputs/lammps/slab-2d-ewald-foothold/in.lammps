units metal
atom_style full
boundary p p f
region box block 0 12 0 12 0 20
create_box 2 box
mass 1 22.99
mass 2 35.45
create_atoms 1 single 3.0 3.0 5.0
create_atoms 1 single 9.0 3.0 5.0
create_atoms 1 single 3.0 9.0 5.0
create_atoms 1 single 9.0 9.0 5.0
create_atoms 2 single 3.0 3.0 15.0
create_atoms 2 single 9.0 3.0 15.0
create_atoms 2 single 3.0 9.0 15.0
create_atoms 2 single 9.0 9.0 15.0
set type 1 charge 1.0
set type 2 charge -1.0

# Real-space cutoff large enough that we can compare real+recip
# Use cutoff 5.9 so same-plane 6.0 neighbors are OUT; only kspace
pair_style coul/long 5.9
pair_coeff * *

# Fixed alpha = 0.5 /Å to match ATV
kspace_style ewald 1.0e-6
kspace_modify gewald 0.5
kspace_modify slab 3.0

dump 1 all custom 1 forces.dump id type q x y z fx fy fz
dump_modify 1 sort id

thermo_style custom step pe ecoul elong
thermo 1
run 0
variable e equal pe
variable el equal elong
print "E_TOTAL ${e}"
print "E_LONG ${el}"
