# Offline pin: fix setforce 0 0 0 freezes wall atoms under LJ forces.
# Units metal: energy eV, distance Å, time ps. timestep 0.001 ps = 1 fs.
# Geometry: 4 wall atoms (type 2) on bottom z=0 plane + 4 fluid (type 1) above.

units metal
atom_style atomic
boundary p p p

region box block 0 10 0 10 0 10
create_box 2 box

# Manual create via create_atoms single
create_atoms 2 single 2.0 2.0 0.0
create_atoms 2 single 2.0 6.0 0.0
create_atoms 2 single 6.0 2.0 0.0
create_atoms 2 single 6.0 6.0 0.0
create_atoms 1 single 2.0 2.0 3.5
create_atoms 1 single 2.0 6.0 3.5
create_atoms 1 single 6.0 2.0 3.5
create_atoms 1 single 6.0 6.0 3.5

mass 1 39.948
mass 2 196.9665

group wall type 2
group fluid type 1

velocity fluid create 200.0 99 dist gaussian mom yes rot no units box
velocity wall set 0.0 0.0 0.0 units box

pair_style lj/cut 8.0
pair_coeff 1 1 0.010341 3.4
pair_coeff 2 2 0.010341 3.4
pair_coeff 1 2 0.010341 3.4

neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes

timestep 0.001

fix 1 all nve
fix 2 wall setforce 0.0 0.0 0.0

compute wx wall property/atom x
compute wy wall property/atom y
compute wz wall property/atom z
compute wvx wall property/atom vx
compute wvy wall property/atom vy
compute wvz wall property/atom vz
compute max_dvx wall reduce max c_wvx
compute max_dvy wall reduce max c_wvy
compute max_dvz wall reduce max c_wvz
compute max_dx wall reduce max c_wx
compute min_dx wall reduce min c_wx
compute max_dz wall reduce max c_wz
compute min_dz wall reduce min c_wz

thermo 100
thermo_style custom step pe ke etotal temp c_min_dx c_max_dx c_min_dz c_max_dz c_max_dvx c_max_dvy c_max_dvz

run 0
variable pe0 equal pe
print "PIN_INIT pe=${pe0}"
print "PIN_INIT wall x in [$(c_min_dx),$(c_max_dx)] z in [$(c_min_dz),$(c_max_dz)] v_max_comp=$(c_max_dvx),$(c_max_dvy),$(c_max_dvz)"

run 1000

print "PIN_FINAL pe=$(pe) ke=$(ke) etotal=$(etotal) temp=$(temp)"
print "PIN_FINAL wall x in [$(c_min_dx),$(c_max_dx)] z in [$(c_min_dz),$(c_max_dz)] v_max_comp=$(c_max_dvx),$(c_max_dvy),$(c_max_dvz)"

# Absolute max displacement of wall atoms from initial (should be 0)
# Write dump for pin table
write_dump wall custom wall_atoms.lammpstrj id type x y z vx vy vz modify sort id
write_dump fluid custom fluid_atoms.lammpstrj id type x y z vx vy vz modify sort id
