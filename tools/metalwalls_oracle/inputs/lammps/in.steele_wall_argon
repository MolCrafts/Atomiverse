# Offline twin: Steele 10-4-3 wall, single Ar (metal units).
# Style: fix wall/lj1043  (true Steele 10-4-3; NOT wall/lj93 which is 9-3)
# Binary: lmp 30 Mar 2026 develop  — ctest never runs this file.
#
# Pin (run 0, fix_modify energy yes):
#   PE = -0.035247965699900359 eV
#   Fz = -0.025162258813859549 eV/Å
# See regressions/forcefield/steele-wall-argon/REFERENCE.md

units metal
atom_style atomic
boundary p p f

region box block 0 20 0 20 0 30
create_box 1 box
mass 1 39.948

create_atoms 1 single 10.0 10.0 4.0

pair_style zero 10.0
pair_coeff * *

# wall/lj1043 zlo coord epsilon sigma cutoff
fix 1 all wall/lj1043 zlo 0.0 0.010338 3.40 12.0 units box
fix_modify 1 energy yes

thermo_style custom step pe etotal f_1
thermo 1

dump 1 all custom 1 forces.dump id x y z fx fy fz
dump_modify 1 format line "%d %.16e %.16e %.16e %.16e %.16e %.16e"

run 0

variable e equal pe
print "ENERGY ${e}"
