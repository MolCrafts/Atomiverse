# MW twin of ATV regression regressions/md/pim-induced-dipole-bulk
# Two-site bulk PIM: q=+1 alpha=1.0 A^3 at origin; q=-1 alpha=1.5 A^3 at 3 A.
# Box 50 A cubic.  All values in atomic units (Bohr, Ha, e).
num_steps 0
timestep  41.341
temperature 0.0

num_pbc 3
box
  length 94.486306231288509 94.486306231288509 94.486306231288509

species

  species_type
    name A
    count 1
    charge point 1.0
    mass 1.0
    polarizability 6.748334494600375

  species_type
    name B
    count 1
    charge point -1.0
    mass 1.0
    polarizability 10.122501741900562

  dipoles_minimization cg 1.0e-14 500

interactions
  coulomb
    coulomb_rtol 1.0e-15
    coulomb_rcut 47.0
    coulomb_ktol 1.0e-15

  # Tang-Toennies charge-dipole damping with intensity c = 0 => NO damping.
  # The block itself is mandatory: MetalWalls only allocates system%tt when a
  # |damping| block is parsed, and coulomb_sr_pim reads tt%order/b/c
  # unconditionally when pimrun is true (unallocated => SIGSEGV).
  damping
     tt_pair   A        B  1.0  1  0.0
     tt_pair   B        A  1.0  1  0.0

output
  default 1
  energies 1 Total Kinetic Potential Coulomb Coulomb_lr Coulomb_keq0 Coulomb_sr Coulomb_self Coulomb_molecule
  dipoles 1
  forces 1
