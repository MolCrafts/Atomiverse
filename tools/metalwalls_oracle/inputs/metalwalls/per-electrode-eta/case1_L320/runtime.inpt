# MetalWalls twin of Atomiverse regression md/per-electrode-eta, case 1.
# Two single-site electrodes at fixed potentials, per-electrode Gaussian
# width eta_e, vacuum (no electrolyte), 2D PBC (xy), separation 4 A.
#
# ATV units -> MW atomic units
#   eta_bot = 1.979 1/A   = 1.047241700377037e+00 1/bohr
#   eta_top = 0.955 1/A   = 5.053642364123649e-01 1/bohr
#   d       = 4.0 A        = 7.558904498503081e+00 bohr
#   DeltaPsi= 1.0 V     = 3.674932217565499e-02 Ha/e
#   L_xy    = 320.0 A        = 6.047123598802465e+02 bohr

num_steps    0
timestep     41.341
temperature  0
num_pbc      2

species

  # Dummy chargeless, non-interacting spectator: MW computes an instantaneous
  # temperature every printed step and divides by the mobile DOF count, which
  # is NaN for an electrode-only cell. One neutral mobile atom at rest makes
  # T = 0 K well-defined and contributes nothing to the electrostatics.
  species_type
    name  Null
    count 1
    mass  1.0
    mobile True
    charge neutral

  species_type
    name  Ebot
    count 1
    mass  196.966569
    mobile False
    charge gaussian 1.047241700377037e+00 0.0

  species_type
    name  Etop
    count 1
    mass  196.966569
    mobile False
    charge gaussian 5.053642364123649e-01 0.0

electrodes

  electrode_type
    name      Ebot
    species   Ebot
    potential 0.0

  electrode_type
    name      Etop
    species   Etop
    potential 3.674932217565499e-02

  electrode_charges matrix_inversion 1.0e-14
  charge_neutrality true electrodes
  compute_force false

interactions
  coulomb
    coulomb_rtol 1.0e-15
    coulomb_rcut 3.017514675802430e+02
    coulomb_ktol 1.0e-15

output
  default 0
  step 1
  charges 1
