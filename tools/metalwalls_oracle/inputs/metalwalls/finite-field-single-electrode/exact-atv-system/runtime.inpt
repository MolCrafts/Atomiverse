# MetalWalls twin of Atomiverse regression `finite-field-single-electrode`.
#
# ATV system (public units): cubic box L = 20 A, 3D PBC, no electrolyte,
# ONE Gaussian electrode site at r = (0, 0, 10) A, eta = 2.0 1/A,
# Psi = 0 V, external field E = (0, 0, 0.1) V/A, electroneutrality OFF.
#
# Unit conversion (Bohr = 0.529177210903 A, Ha = 27.211386245988 eV):
#   L    = 20 A   -> 37.794522492515405 bohr
#   z    = 10 A   -> 18.897261246257703 bohr
#   eta  = 2 1/A  -> 1.058354421806     1/bohr
#   Psi  = 0 V    -> 0.0                Ha/e
#   Ez   = 0.1 V/A-> 1.944690381148888e-03 a.u.   (1 a.u. = 51.4220674763 V/A)

# Global parameters
num_steps 0
timestep  41.341
temperature 0.0

# Box
# ---
num_pbc 3
box
  length 37.794522492515405 37.794522492515405 37.794522492515405

# Species definition
# ------------------
species

  species_type
    name  E1
    count 1
    mass  196.966553
    mobile False
    charge gaussian 1.058354421806 0.0

# Electrode definition
# --------------------
electrodes

  electrode_type
    name    E1
    species E1
    potential 0.000

  electrode_charges matrix_inversion
  charge_neutrality false

# Interactions
# ------------
interactions
  coulomb
    coulomb_rtol 1.0e-12
    coulomb_rcut 18.0
    coulomb_ktol 1.0e-12

# External field (Dufils finite-field)
# ------------------------------------
external_field
  type E
  direction 0.00 0.00 1.00
  amplitude 1.944690381148888e-03

output
  default 0
  charges 1
  energies 1 Total Potential External_field
  total_charges 1
  polarization 1
