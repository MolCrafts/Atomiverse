# MetalWalls twin of Atomiverse regression maze-symplectic-charge-dynamics
# twin A: regression box, MW 3D Ewald, 800-step NVE
# Generated by gen_inputs.py -- all values are atomic units.
# ATV source values: box 6.0 x 6.0 x 20.0 A, eta 2.0 1/A,
# Psi_bot 0.0 V, Psi_top 1.0 V, dt 0.25 fs, ions 40.0 amu.

num_steps 800
timestep  10.335343333795          # 0.25 fs
temperature 300.0            # only sets MW's kinetic sanity threshold; v(0)=0

num_pbc  3
box
  length 11.338356747754622 11.338356747754622 37.794522492515405

species

  species_type
    name       Ip
    count      1
    charge point  +0.5
    mass   40.0

  species_type
    name       Im
    count      1
    charge point  -0.5
    mass   40.0

  species_type
    name       E1
    count      4
    charge gaussian 1.058354421806000 0.0
    mass   196.97
    mobile False

  species_type
    name       E2
    count      4
    charge gaussian 1.058354421806000 0.0
    mass   196.97
    mobile False

electrodes

  electrode_type
    name       E1
    species    E1
    potential  0.000000000000000      # 0.0 V

  electrode_type
    name       E2
    species    E2
    potential  0.036749322175655      # 1.0 V

  electrode_charges maze inversion 1.0e-14
  charge_neutrality true electrodes
  compute_force true

interactions
  coulomb
    coulomb_rtol       1.0e-12
    coulomb_rcut       5.480205761415
    coulomb_ktol       1.0e-12

output
  step 1
  charges 1
  forces 1
  energies 1 Hamiltonian Kinetic Potential Coulomb Coulomb_lr Coulomb_keq0 Coulomb_sr Coulomb_self
