# MetalWalls twin of Atomiverse regression maze-charge-dynamics
# 8x8 supercell, ion+ at z = 9.0 A (regression launch 0)
# Generated by gen_inputs.py -- every value below is in atomic units.
# ATV source values: lateral lattice 1 A (here an 8 x 8 supercell),
# Lz 20.0 A, eta 2.0 1/A, Psi_bot 0.0 V, Psi_top 1.0 V,
# ions +0.5 e at z 9.0 A and -0.5 e at z 11.0 A.

num_steps 0
timestep  10.335343333795          # 0.25 fs
temperature 300.0            # only sets MW's kinetic sanity threshold; v(0)=0

num_pbc  2
box
  length 15.117808997006161 15.117808997006161 37.794522492515405

species

  species_type
    name       Ip
    count      64
    charge point  0.5
    mass   1.0

  species_type
    name       Im
    count      64
    charge point  -0.5
    mass   1.0

  species_type
    name       E1
    count      64
    charge gaussian 1.058354421806000 0.0
    mass   1.0
    mobile False

  species_type
    name       E2
    count      64
    charge gaussian 1.058354421806000 0.0
    mass   1.0
    mobile False

electrodes

  electrode_type
    name       E1
    species    E1
    potential  0.000000000000000      # 0.0 V

  electrode_type
    name       E2
    species    E2
    potential  0.036749322175655      # 1.0 V

  electrode_charges matrix_inversion 1.0e-14
  charge_neutrality true electrodes
  compute_force true

interactions
  coulomb
    coulomb_rtol       1.0e-12
    coulomb_rcut       7.558904498503
    coulomb_ktol       1.0e-12
    ewald_zweight      1.0

output
