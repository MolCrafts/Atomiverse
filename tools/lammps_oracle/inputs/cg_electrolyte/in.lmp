# cg-electrolyte single point (generated by make_case.py).
# lmp -in in.lmp -var term <fene|angle|lj|r4|coul|kspace|total>
units           metal
atom_style      full
boundary        p p p
read_data       data.lmp
special_bonds   lj/coul 1.0 1.0 1.0
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check no one 10000

if "${term} == fene" then &
  "bond_style fene" "bond_coeff 1 0.77555999358000005 1.5 0.0 1.0" &
  "angle_style zero" "angle_coeff *" &
  "pair_style zero 3.5" "pair_coeff * *"
if "${term} == angle" then &
  "bond_style zero" "bond_coeff *" &
  "angle_style cosine" "angle_coeff 1 0.051703999572000003" &
  "pair_style zero 3.5" "pair_coeff * *"
if "${term} == lj" then &
  "bond_style zero" "bond_coeff *" "angle_style zero" "angle_coeff *" &
  "pair_style lj/cut 3" "pair_modify shift yes" &
  "include lj_rows.lmp"
if "${term} == r4" then &
  "bond_style zero" "bond_coeff *" "angle_style zero" "angle_coeff *" &
  "pair_style hybrid zero 3.5 table linear 200000" &
  "pair_coeff * * zero" "pair_coeff 2 6 table r4.table R4 1.9375"
if "${term} == coul" then &
  "bond_style zero" "bond_coeff *" "angle_style zero" "angle_coeff *" &
  "pair_style coul/long 3.5" "pair_coeff * *" &
  "pair_modify table 0" &
  "kspace_style pppm 1.0e-8" &
  "kspace_modify gewald 1.1000000000000001 mesh 32 32 32 order 6"
if "${term} == kspace" then &
  "bond_style zero" "bond_coeff *" "angle_style zero" "angle_coeff *" &
  "pair_style coul/long 0.05" "pair_coeff * *" &
  "pair_modify table 0" &
  "kspace_style pppm 1.0e-8" &
  "kspace_modify gewald 1.1000000000000001 mesh 32 32 32 order 6"
if "${term} == total" then &
  "bond_style fene" "bond_coeff 1 0.77555999358000005 1.5 0.0 1.0" &
  "angle_style cosine" "angle_coeff 1 0.051703999572000003" &
  "pair_style hybrid/overlay lj/cut/coul/long 3 3.5 table linear 200000" &
  "include lj_rows_hybrid.lmp" &
  "pair_coeff 2 6 table r4.table R4 1.9375" &
  "pair_modify pair lj/cut/coul/long shift yes table 0" &
  "kspace_style pppm 1.0e-8" &
  "kspace_modify gewald 1.1000000000000001 mesh 32 32 32 order 6"

compute         vir all pressure NULL virial
thermo_style    custom step pe ebond eangle evdwl ecoul elong vol
thermo_modify   norm no
run             0
print           "ATV_RESULT term ${term} pe $(pe:%.17g) ebond $(ebond:%.17g) eangle $(eangle:%.17g) evdwl $(evdwl:%.17g) ecoul $(ecoul:%.17g) elong $(elong:%.17g) vol $(vol:%.17g)"
print           "ATV_VIRIAL term ${term} $(c_vir[1]:%.17g) $(c_vir[2]:%.17g) $(c_vir[3]:%.17g) $(c_vir[4]:%.17g) $(c_vir[5]:%.17g) $(c_vir[6]:%.17g)"
write_dump      all custom forces.${term}.dump id fx fy fz modify sort id format float %.17g
