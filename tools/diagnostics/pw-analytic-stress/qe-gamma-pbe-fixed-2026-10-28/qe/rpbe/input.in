&CONTROL
 calculation='scf', prefix='skew_si2_rpbe', pseudo_dir='./',
 outdir='./scratch', tprnfor=.true., tstress=.true., verbosity='high'
/
&SYSTEM
 ibrav=0, nat=2, ntyp=1, ecutwfc=12.0, ecutrho=48.0,
 nr1=48, nr2=54, nr3=48, nr1s=48, nr2s=54, nr3s=48,
 input_dft='RPBE', occupations='fixed',
 nspin=1, nbnd=4, nosym=.true., noinv=.true.
/
&ELECTRONS
 conv_thr=1.0d-12, electron_maxstep=250, mixing_beta=0.2,
 diagonalization='david', diago_thr_init=1.0d-12
/
ATOMIC_SPECIES
Si 28.0855 Si_GTH_PBE_q4.gth
CELL_PARAMETERS angstrom
0.10 2.70 2.65
2.75 0.05 2.70
2.65 2.75 0.15
ATOMIC_POSITIONS angstrom
Si 0.2 0.3 0.4
Si 1.57 1.66 1.75
K_POINTS gamma
