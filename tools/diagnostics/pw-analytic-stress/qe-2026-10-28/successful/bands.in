&CONTROL
 calculation='nscf', prefix='skew_si2_lsda', pseudo_dir='./',
 outdir='./scratch', tprnfor=.false., tstress=.false., verbosity='high'
/
&SYSTEM
 ibrav=0, nat=2, ntyp=1, ecutwfc=12.0, ecutrho=48.0,
 nr1=24, nr2=28, nr3=24, nr1s=24, nr2s=28, nr3s=24,
 input_dft='SLA+VWN+NOGX+NOGC', occupations='fixed',
 nspin=1, nbnd=6, nosym=.true., noinv=.true.
/
&ELECTRONS
 conv_thr=1.0d-12, electron_maxstep=250, mixing_beta=0.2,
 diagonalization='david', diago_thr_init=1.0d-12, startingpot='file', startingwfc='atomic'
/
ATOMIC_SPECIES
Si 28.0855 Si_GTH_PBE_q4.gth
CELL_PARAMETERS angstrom
0.10 2.70 2.65
2.75 0.05 2.70
2.65 2.75 0.15
ATOMIC_POSITIONS angstrom
Si 0.2 0.3 0.4
Si 1.57 1.66 1.75
K_POINTS gamma
