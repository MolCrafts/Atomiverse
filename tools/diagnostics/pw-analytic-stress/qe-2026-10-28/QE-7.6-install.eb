# created by Luca Marsella (CSCS)
# adapted for LUMI by the LUMI User Support Team
# adapted for Arrhenius by Johan Hellsvik (KCSC)

easyblock = 'CMakeMake'

name = 'QuantumESPRESSO'
version = '7.6'

homepage = 'https://www.quantum-espresso.org/'

description = """
Quantum ESPRESSO is an integrated suite of computer codes for
electronic-structure calculations and materials modeling at the nanoscale. It is
based on density-functional theory, plane waves, and pseudopotentials (both
norm-conserving and ultrasoft).
"""

docurls = [
    'User guide: https://www.quantum-espresso.org/Doc/user_guide/',
]

toolchain = {'name': 'gmpflf', 'version': '2026.03'}
toolchainopts = {'openmp': True, 'opt': True, 'pic': True, 'usempi': True}

sources = ['https://gitlab.com/QEF/q-e/-/archive/qe-%(version_major)s.%(version_minor)s/q-e-qe-%(version_major)s.%(version_minor)s.tar.gz']

checksums = ['945c8f16ab330c8f0b30f4de1a9a088b85038476fcd819394e641f4d2d8b7d51']  #q-e-qe-7.6.tar.gz

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('libxc', '7.0.0'),
    ('ELPA', '2026.02.002'),
    ('HDF5', '1.14.6'),
]

configopts  = '-DQE_ENABLE_LIBXC=1 -DQE_ENABLE_OPENMP=1 -DQE_ENABLE_SCALAPACK=1 '
configopts += '-DQE_ENABLE_ELPA=1 -DQE_ENABLE_HDF5=1 '

buildopts = "all epw"

runtest = 'test'

sanity_check_paths = {
    'files': ['bin/pw.x', 'bin/ph.x', 'bin/epw.x'],
    'dirs': [''],
}

moduleclass = 'chem'
