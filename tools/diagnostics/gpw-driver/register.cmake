# Complete physical GPW diagnostics, deliberately outside CTest.
if(ATV_BUILD_GPW)
    foreach(mode IN ITEMS cpu oracles preflight)
        add_executable(gpw-driver-${mode} "${CMAKE_CURRENT_LIST_DIR}/${mode}.cpp")
        target_link_libraries(gpw-driver-${mode} PRIVATE atomiverse)
        target_compile_features(gpw-driver-${mode} PRIVATE cxx_std_20)
        set_target_properties(gpw-driver-${mode} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    endforeach()
    if(ATV_BUILD_CUDA)
        add_executable(gpw-driver-cuda "${CMAKE_CURRENT_LIST_DIR}/cuda.cpp")
        target_link_libraries(gpw-driver-cuda PRIVATE atomiverse)
        target_compile_features(gpw-driver-cuda PRIVATE cxx_std_20)
        set_target_properties(gpw-driver-cuda PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
        if(ATV_BUILD_PW)
            add_executable(gpw-driver-uks-pbe "${CMAKE_CURRENT_LIST_DIR}/uks_pbe.cpp")
            target_link_libraries(gpw-driver-uks-pbe PRIVATE atomiverse)
            target_compile_features(gpw-driver-uks-pbe PRIVATE cxx_std_20)
            set_target_properties(gpw-driver-uks-pbe PROPERTIES
                RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
        endif()
    endif()
endif()
if(ATV_BUILD_GPW)
    include("${CMAKE_CURRENT_LIST_DIR}/../pbe-periodic-oracles/register-cp2k.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../pbe-periodic-oracles/register-uks.cmake")
endif()

# Preserve the preceding PW/PBE-family acceptance envelope in this build.
include("${CMAKE_CURRENT_LIST_DIR}/../pbe-family/register.cmake")
if(ATV_BUILD_PW)
    include("${CMAKE_CURRENT_LIST_DIR}/../pbe-periodic-oracles/register.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../pw-analytic-stress/register.cmake")
endif()
