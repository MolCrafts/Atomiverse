&GLOBAL
  PROJECT si2_matched_vib
  RUN_TYPE VIBRATIONAL_ANALYSIS
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    WFN_RESTART_FILE_NAME si2_matched_geo_opt-RESTART.wfn
    LSD
    MULTIPLICITY 3
    &MGRID
      CUTOFF 150
      REL_CUTOFF 40
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      CORE_PPL GRID
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 100
      EPS_SCF 1.0E-7
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.01
        STEPSIZE 0.1
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      PSOLVER MT
      &MT
        REL_CUTOFF 4.0
      &END MT
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC NONE
    &END CELL
    &COORD
      Si 2.927454741900 4.000000000000 4.000000000000
      Si 5.072545258100 4.000000000000 4.000000000000
    &END COORD
    &KIND Si
      MASS 28.0855
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL

&VIBRATIONAL_ANALYSIS
  DX [angstrom] 0.001
  FULLY_PERIODIC F
&END VIBRATIONAL_ANALYSIS
