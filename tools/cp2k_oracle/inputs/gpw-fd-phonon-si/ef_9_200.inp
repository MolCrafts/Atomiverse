! Si2 dimer, UKS triplet (3Sigma_g^- ground state), isolated cluster.
! GPW PADE + DZVP-MOLOPT-GTH + GTH-PBE-q4, CUTOFF 200 Ry, MT Poisson.
! Molecule centred in a 10 A cube (cluster boundary conditions require it).
&GLOBAL
  PROJECT ef_9_200
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&VIBRATIONAL_ANALYSIS
  DX 0.001
  FULLY_PERIODIC F
  &PRINT
    &PROGRAM_RUN_INFO ON
    &END PROGRAM_RUN_INFO
  &END PRINT
&END VIBRATIONAL_ANALYSIS
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 500
      EPS_SCF 1.0E-7
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.0 9.0 9.0
      PERIODIC NONE
    &END CELL
    &COORD
      Si 3.377000 4.500000 4.500000
      Si 5.623000 4.500000 4.500000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
