! CP2K twin for regressions/gpw/gpw-bands-uks — GTH-GPW collinear UKS band
! structure on diamond Si (bct 4-atom, DZVP-MOLOPT-GTH + GTH-PBE-q4, PBE).
! Run OFFLINE only; never at ctest time.
!
!   source …/cp2k/install/env.sh
!   ln -sf $CP2K_DATA_DIR/{BASIS_MOLOPT,GTH_POTENTIALS} .
!   OMP_NUM_THREADS=8 mpirun -np 1 cp2k.psmp -i si_uks_bands.inp -o si_uks_bands.out

&GLOBAL
  PROJECT si_gpw_uks_bands_bct
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    &MGRID
      CUTOFF 150
      NGRIDS 1
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 60
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
      ADDED_MOS 4
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        ADDED_MOS 4
        FILE_NAME si_gpw_uks_bands
        &KPOINT_SET
          NPOINTS 4
          SPECIAL_POINT GAMMA 0.0 0.0 0.0
          SPECIAL_POINT X 0.5 0.0 0.5
          SPECIAL_POINT W 0.5 0.25 0.75
          SPECIAL_POINT L 0.5 0.5 0.5
          SPECIAL_POINT GAMMA 0.0 0.0 0.0
          SPECIAL_POINT K 0.375 0.375 0.75
        &END KPOINT_SET
      &END BAND_STRUCTURE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.83959 3.83959 5.43000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.50 0.50 0.50
      Si 0.50 0.00 0.25
      Si 0.00 0.50 0.75
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
