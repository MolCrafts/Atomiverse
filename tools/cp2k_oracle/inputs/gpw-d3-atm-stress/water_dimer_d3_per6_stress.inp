! Offline CP2K twin for regressions/gpw/gpw-d3-atm-stress/
! Never launched by ctest. C9 .FALSE. member of the ATM delta-stress pin
! pair — identical to water_dimer_d3_atm_per6_stress.inp except
! CALCULATE_C9_TERM. Pin = sigma(ATM twin) MINUS sigma(this run): D3 is
! geometry-only, so the SCF density and the two-body dispersion are identical
! in both runs at every perturbed cell — the difference isolates the pure
! ATM (C9) stress. EPS_SCF 1e-8 as in the ATM twin.
!
! Example (Arrhenius epyc login, offline only):
!   module load buildtool-easybuild/5.2.1-hpca3ef7d197 GCC/14.3.0 \
!               MPICH/4.3.2 CP2K/2026.1
!   export CP2K_DATA_DIR=/software/sse2/el9_epyc9005/easybuild/prefix/\
!software/CP2K/2026.1-gmpflf-2026.03/share/cp2k/data
!   mpirun -np 2 cp2k.psmp -i water_dimer_d3_per6_stress.inp \
!          -o water_dimer_d3_per6_stress.out
&GLOBAL
  PROJECT water_dimer_d3_per6_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 50
      EPS_SCF 1.0E-8
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-8
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 10.0
          LONG_RANGE_CORRECTION .FALSE.
          CALCULATE_C9_TERM .FALSE.
          VERBOSE_OUTPUT .TRUE.
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
