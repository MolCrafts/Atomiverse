! Offline CP2K twin for regressions/gpw/gpw-d3-atm-kpoint-stress/
! Never launched by ctest. C9 .FALSE. member of the multi-k ATM
! delta-stress pin pair — identical to water_dimer_d3_atm_k_stress.inp
! except CALCULATE_C9_TERM. Pin = sigma(ATM twin) MINUS sigma(this run).
!
! Fair wall companion only; use the C9 run for T_oracle of the product claim.
!   source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
!   export OMP_NUM_THREADS=8
!   mpirun -np 1 cp2k.psmp -i water_dimer_d3_k_stress.inp \
!          -o water_dimer_d3_k_stress.out
&GLOBAL
  PROJECT water_dimer_d3_k_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      FULL_GRID .FALSE.
      SYMMETRY .FALSE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 80
      EPS_SCF 1.0E-8
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 10.0
          LONG_RANGE_CORRECTION .FALSE.
          CALCULATE_C9_TERM .FALSE.
          VERBOSE_OUTPUT .TRUE.
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
