! Offline twin for regressions/gpw/periodic-urpa-kpoints (never launched by ctest).
! Multi-k GPW unrestricted RI-RPA on diamond Si (bct 4-atom): a=5.43 Å,
! UKS PBE reference with MULTIPLICITY 1 (nα=nβ), DZVP-MOLOPT-GTH +
! GTH-PBE-q4, CUTOFF 80 Ry, MONKHORST-PACK 2 1 1 (FULL_GRID / no symmetry
! ≈ Atomiverse k_time_reversal=false equal weights). ADDED_MOS 2 matches
! Atomiverse mp2_n_virt=2 (e2e virt cap).
!
! CP2K path is frequency-integrated RI-RPA with Gaussian RI_AUX (not the
! exact q-resolved plasmon formula on PW-RI (ia|jb) that Atomiverse
! implements). Use printed correlation energy as a near-twin diagnostic;
! Atomiverse dual-gates multi-k URPA@UKS E_c against closed-shell multi-k
! dRPA (REFERENCE.md).
&GLOBAL
  PROJECT periodic-urpa-kpoints
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UNRESTRICTED_KOHN_SHAM
    MULTIPLICITY 1
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 80
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
      FULL_GRID .TRUE.
      SYMMETRY .FALSE.
    &END KPOINTS
    &SCF
      MAX_SCF 100
      EPS_SCF 1.0E-7
      SCF_GUESS ATOMIC
      ADDED_MOS 2
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        MEMORY 2000
        NUMBER_PROC 1
        &INTEGRALS
          &WFC_GPW
            CUTOFF 80
            REL_CUTOFF 20
            EPS_FILTER 1.0E-8
            EPS_GRID 1.0E-8
          &END WFC_GPW
        &END INTEGRALS
        &RI_RPA
          MINIMAX
          RPA_NUM_QUAD_POINTS 8
          &HF
            FRACTION 1.0
            &SCREENING
              EPS_SCHWARZ 1.0E-6
              SCREEN_ON_INITIAL_P FALSE
            &END SCREENING
          &END HF
        &END RI_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ! bct diamond: a_t = a/sqrt(2), c = a; a = 5.43 Å
      ABC 3.839590 3.839590 5.430000
      PERIODIC XYZ
    &END CELL
    &COORD
      Si 0.000000 0.000000 0.000000
      Si 1.919795 1.919795 2.715000
      Si 1.919795 0.000000 1.357500
      Si 0.000000 1.919795 4.072500
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      BASIS_SET RI_AUX RI_DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
