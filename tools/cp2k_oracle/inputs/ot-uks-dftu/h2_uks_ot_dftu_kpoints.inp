! CP2K twin for regressions/gpw/ot-uks-dftu.
! NOTE (CP2K 2026.1): OT is incompatible with k-points
!   ("OT not possible with kpoint calculations" in qs_scf_initialization).
! This input is the **DIIS/diagonalization** multi-k UKS PLUS_U twin of the
! ATV multi-k UKS OT+U product path (same fixed point as reg A2/A3 identities).
! Run OFFLINE only; never at ctest time.
! Cell 8 Bohr cubic, high-spin H2 DZV-GTH-PADE, PADE LSD, CUTOFF 100,
! MONKHORST-PACK 2×1×1, DFT_PLUS_U L=0 U-J=4 eV on H, MULTIPLICITY 3.

&GLOBAL
  PROJECT h2_uks_ot_dftu_kpoints
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    PLUS_U_METHOD MULLIKEN
    &MGRID
      CUTOFF 100
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 300
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.35
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H  3.3  4.0  4.0
      H  4.7  4.0  4.0
    &END COORD
    &KIND H
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PADE-q1
      &DFT_PLUS_U
        L 0
        U_MINUS_J [eV] 4.0
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
