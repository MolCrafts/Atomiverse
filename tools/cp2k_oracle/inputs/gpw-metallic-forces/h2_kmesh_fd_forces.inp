! Matched fair-wall twin for regressions/gpw/gpw-metallic-forces (H2, k 1×1×2,
! FERMI_DIRAC SMEAR, ENERGY_FORCE). Basis DZVP-MOLOPT-GTH (ATV pin uses
! DZV-GTH-PADE — same algorithm class; absolute E/F not compared).
&GLOBAL
  PROJECT h2_kmesh_fd_forces
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 100
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 60
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 3157.75
      &END SMEAR
      ADDED_MOS 2
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.35013 6.35013 6.35013
      PERIODIC XYZ
    &END CELL
    &COORD
      ! Bohr → Å: 0.52917720859; positions match ATV off-symmetry H2 (Å)
      H  2.91047  3.17506  3.17506
      H  3.54549  3.22798  3.12215
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
