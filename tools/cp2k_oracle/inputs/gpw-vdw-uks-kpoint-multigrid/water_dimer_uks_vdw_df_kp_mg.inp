! Water dimer closed-shell LSD (MULT 1) PBE + DRSLL + MP 2x1x1 + NGRIDS 4
! Triple-combo twin: multi-k UKS × nonlocal vdW × REL_CUTOFF multigrid
! Geometry family: gpw-vdw-df-ice / gpw-vdw-uks-kpoints. Run OFFLINE only.

&GLOBAL
  PROJECT water_dimer_uks_vdw_df_kp_mg
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 1
    CHARGE 0
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 60
      EPS_SCF 1.0E-7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE NON_LOCAL
        &NON_LOCAL
          TYPE DRSLL
          KERNEL_FILE_NAME vdW_kernel_table.dat
          SCALE 1.0
        &END NON_LOCAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
