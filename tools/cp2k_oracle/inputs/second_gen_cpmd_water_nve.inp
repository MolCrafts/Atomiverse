# CP2K twin for regressions/dynamics/second-gen-cpmd-water (offline oracle —
# never run at ctest/regression time). Second-generation Car–Parrinello MD
# (Kühne et al., PRL 98, 066401 (2007)): ASPC density extrapolation + limited
# SCF corrector on the same H2O NVE twin as gpw-bomd / xl-bomd / cpmd-water.
# NOTE (2026-07-25): no cp2k binary/module on the worker host — unexecuted
# sketch for a future re-pin (see REFERENCE.md).
&GLOBAL
  PROJECT second_gen_cpmd_water_nve
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 8
    TIMESTEP 0.5
    TEMPERATURE 10.0
  &END MD
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      # Second-generation CP: ASPC predictor-corrector (Kolafa 2004).
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 1
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      # Limited corrector budget — the SGCP signature vs full BOMD MAX_SCF.
      MAX_SCF 5
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  5.0000  5.0000  5.0000
      H  5.7586  5.0000  5.5043
      H  4.2414  5.0000  5.5043
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
