! Offline CP2K twin — NUMERICAL stress pins (run at a = 3.04 and 3.19).
! Never launched by ctest. sed "s/AAA/<a>/g" per scan point:
!   a in 2.80 2.86 2.92 2.98 3.04 3.10 3.13 3.16 3.19 3.22 3.25, pin at 3.200
! Fixed fractional (SCALED) coordinates — the exact functional E(a) the
! Atomiverse fixed-fractional cell relax minimizes.
&GLOBAL
  PROJECT chain_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC AAA 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      O   0.000000  0.000000  0.000000
      H   0.319067  0.000000  0.000000
      H  -0.079900  0.000000  0.115830
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
