! CP2K twin for regressions/gpw/gpw-dftu-kpoint-stress
! Multi-k UKS + Dudarev PLUS_U + NUMERICAL stress on high-spin H2.
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Twin geometry matches reg_gpw-dftu-kpoints / unit dual-gate (8 Bohr cell,
! MP 1x1x2 for cheaper NUMERICAL stress). DZV-GTH-PADE in BASIS_SET.

&GLOBAL
  PROJECT h2_uks_dftu_kpoint_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    PLUS_U_METHOD MULLIKEN
    LSD
    MULTIPLICITY 3
    CHARGE 0
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 100
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.35
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H  3.3  4.0  4.0
      H  4.7  4.0  4.0
    &END COORD
    &KIND H
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PADE-q1
      &DFT_PLUS_U
        L 0
        U_MINUS_J [eV] 4.0
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
