! CP2K twin for regressions/gpw/gpw-uks-multigrid-kpoints — Monkhorst-Pack
! k-point collinear UKS (LSD) GPW with REL_CUTOFF multigrid product
! collocation: NGRIDS 4, REL_CUTOFF 40 Ry.
!
! System: closed-shell H2 on the UKS path (multiplicity 1 → Nα=1, Nβ=1) in
! an 8 Bohr cubic periodic cell, bond 1.4 Bohr along x,
! DZVP-MOLOPT-GTH / GTH-PBE-q1, PBE LSD. Dual-spin product stacks are
! exercised (ρα=ρβ). DZV-GTH-PADE/PADE on this toy sits ~22 mHa off ATV
! (table-matched basis; residual XC/PP-grid systematic) — MOLOPT+PBE is the
! absolute-pin class that matches the multigrid-kpoints Si precedent.
!
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Pin: total energy [Ha] -> regressions/gpw/gpw-uks-multigrid-kpoints/REFERENCE.md.
! NGRIDS-1 context twin: same deck with NGRIDS 1 (drop REL_CUTOFF).
&GLOBAL
  PROJECT h2_uks_kpoints_mg
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 1
    CHARGE 0
    &MGRID
      CUTOFF 200
      NGRIDS 4
      REL_CUTOFF 40
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 80
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H  3.300000  4.000000  4.000000
      H  4.700000  4.000000  4.000000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
