! O2 triplet LSD optB88-vdW (optB88-x + PW92 + DRSLL) — periodic Γ twin
! Twin for Atomiverse regressions/gpw/gpw-optb88-uks
! Geometry: R(O-O) = 1.2075 Å centered in a 12 Å cubic cell, PERIODIC XYZ
! (nonlocal RPS kernel requires the periodic Poisson route on both sides).
! Valence: 12 e- (GTH-q6), multiplicity 3 → Nα=7, Nβ=5
! XC: CP2K 2026.1 libxc-named subsections (data/xc_section/vdW-DF-optB88.sec):
!     GGA_X_OPTB88_VDW + PW92 + NON_LOCAL TYPE DRSLL.
! SCF: OT (Broyden+diag diverged on this combo; OT matches the RKS
!     water_dimer_optb88_vdw twin recipe).

&GLOBAL
  PROJECT o2_uks_optb88_vdw
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    CHARGE 0
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 50
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GGA_X_OPTB88_VDW
        &END GGA_X_OPTB88_VDW
        &PW92
        &END PW92
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE NON_LOCAL
        &NON_LOCAL
          TYPE DRSLL
          KERNEL_FILE_NAME vdW_kernel_table.dat
          SCALE 1.0
        &END NON_LOCAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  6.000000  6.000000  5.396250
      O  6.000000  6.000000  6.603750
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
