! O2 triplet UKS / PBE / DZVP-MOLOPT-GTH + GTH-PBE-q6 — periodic MP 2x2x2
! Twin for Atomiverse regressions/gpw/gpw-kpoints-uks (product documentation pin)
! Geometry: R(O-O) = 1.2075 A, cubic L = 8.0 A (PERIODIC XYZ)
! Valence: 12 e- (GTH-q6), multiplicity 3 → Nα=7, Nβ=5
! Offline pin (CP2K 2026.1): E = -31.92842018097085 Ha (22 SCF steps, ~175 s OMP=4)
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.

&GLOBAL
  PROJECT o2_uks_kpoints
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    CHARGE 0
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      MAX_SCF 120
      EPS_SCF 1.0E-6
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  4.000000  4.000000  3.396250
      O  4.000000  4.000000  4.603750
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
