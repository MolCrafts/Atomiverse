! CP2K twin for regressions/gpw/gpw-dos-metallic — multi-k GPW RKS free-
! energy SCF with Fermi–Dirac metallic smear + &PRINT &DOS on BCC Na.
! Matched algorithm class: Quickstep GPW + MONKHORST-PACK 2×2×2 + SMEAR
! FERMI_DIRAC + total DOS print on the SCF multi-k spectrum.
! Absolute D(E) is not a pin (CP2K histogram vs ATV Gaussian); free energy,
! Fermi level, and DOS character (∫^{E_F} D ≈ N_e) are.
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
!
! source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
! export OMP_NUM_THREADS=4
! ln -sf $CP2K_DATA_DIR/{BASIS_MOLOPT,GTH_POTENTIALS} .
! mpirun -np 1 cp2k.psmp -i na_bcc_fd_dos.inp -o na_bcc_fd_dos.out

&GLOBAL
  PROJECT na_bcc_fd_dos
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 80
      ADDED_MOS 4
      &SMEAR ON
        METHOD FERMI_DIRAC
        ! ~0.02 Ry electronic temperature (k_B T)
        ELECTRONIC_TEMPERATURE [K] 3157.75
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &DOS
        DELTA_E 0.005
        NDIGITS 8
      &END DOS
      &MO_CUBES
        NHOMO 2
        NLUMO 2
        WRITE_CUBE .FALSE.
      &END MO_CUBES
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ! BCC conventional cubic a = 4.225 Å
      ABC 4.225 4.225 4.225
      PERIODIC XYZ
    &END CELL
    &COORD
      Na 0.0 0.0 0.0
      Na 2.1125 2.1125 2.1125
    &END COORD
    &KIND Na
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
