! CP2K twin for regressions/gpw/gpw-metallic-stress —
! multi-k RKS free-energy cell stress under FERMI_DIRAC smear (BCC Na).
! Matched GPW class: GTH-PBE-q9 + DZVP-MOLOPT-SR-GTH, PADE, MP 2×2×2, CUTOFF 150.
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Pin: STRESS_TENSOR NUMERICAL [Ha/Bohr^3] + free energy / Fermi level.
&GLOBAL
  PROJECT na_bcc_fermi_dirac_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 80
      &SMEAR ON
        METHOD FERMI_DIRAC
        ! ~0.02 Ry electronic temperature (k_B T)
        ELECTRONIC_TEMPERATURE [K] 3157.75
      &END SMEAR
      ADDED_MOS 4
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      ! BCC conventional cubic a = 4.225 Å
      ABC 4.225 4.225 4.225
      PERIODIC XYZ
    &END CELL
    &COORD
      Na 0.0 0.0 0.0
      Na 2.1125 2.1125 2.1125
    &END COORD
    &KIND Na
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q9
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
