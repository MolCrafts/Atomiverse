! CP2K twin for regressions/gpw/gpw-kpoints-si — Monkhorst-Pack k-point GPW
! RKS on diamond Si in the bct 4-atom cell (DZVP-MOLOPT-GTH + GTH-PBE-q4).
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Pin: total energy [Ha] -> replace the frozen first-green value in
! regressions/gpw/gpw-kpoints-si/REFERENCE.md and reg_gpw-kpoints-si.cpp
! (cite the CP2K version). ATV first green: E = -15.8023941333 Ha.
&GLOBAL
  PROJECT si_kpoints_bct
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150
      NGRIDS 1
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 60
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ! bct setting of diamond: (a/sqrt(2), a/sqrt(2), a), a = 5.43 A
      ABC 3.83959 3.83959 5.43000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.50 0.50 0.50
      Si 0.50 0.00 0.25
      Si 0.00 0.50 0.75
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
