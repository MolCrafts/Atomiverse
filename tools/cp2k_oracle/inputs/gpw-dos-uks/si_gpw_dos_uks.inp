! CP2K twin for regressions/gpw/gpw-dos-uks — multi-k GPW collinear UKS DOS
! on diamond Si (bct 4-atom cell, DZVP-MOLOPT-GTH + GTH-PBE-q4, PBE LSD).
! Matched algorithm class: Quickstep GPW + LSD (multiplicity 1) +
! MONKHORST-PACK 2×2×2 + &PRINT &DOS (eigenvalue histogram on the SCF k mesh;
! ATV Gaussian-smears dual-spin multi-k ε_nk^σ). Absolute D(E) is not a pin —
! energy + dual-spin DOS character (nspin=2, occupied integral / open gap)
! are.
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
!
! source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
! export OMP_NUM_THREADS=4
! ln -sf $CP2K_DATA_DIR/{BASIS_MOLOPT,GTH_POTENTIALS} .
! mpirun -np 1 cp2k.psmp -i si_gpw_dos_uks.inp -o si_gpw_dos_uks.out

&GLOBAL
  PROJECT si_gpw_dos_uks
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 1
    CHARGE 0
    &MGRID
      CUTOFF 150
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-7
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 60
      ADDED_MOS 8
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &DOS
        ! Energy bin width [Ha] for the histogram write-out.
        DELTA_E 0.005
        NDIGITS 8
      &END DOS
      &PDOS
        NLUMO 8
        COMPONENTS .FALSE.
      &END PDOS
      &MO_CUBES
        NHOMO 2
        NLUMO 2
        WRITE_CUBE .FALSE.
      &END MO_CUBES
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ! bct setting of diamond: (a/sqrt(2), a/sqrt(2), a), a = 5.43 A
      ABC 3.83959 3.83959 5.43000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.50 0.50 0.50
      Si 0.50 0.00 0.25
      Si 0.00 0.50 0.75
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
