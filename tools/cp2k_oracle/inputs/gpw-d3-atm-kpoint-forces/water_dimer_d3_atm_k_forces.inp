! Offline CP2K twin for regressions/gpw/gpw-d3-atm-kpoint-forces/
! Never launched by ctest. Multi-k (1x1x2) + DFT-D3 zero damping with
! CALCULATE_C9_TERM .TRUE. + ENERGY_FORCE on the periodic 6 A water-dimer
! cell of gpw-d3-atm-forces / gpw-d3-atm-kpoint-stress.
! Pin = FORCES| of this run MINUS C9 .FALSE. twin
! (water_dimer_d3_k_forces.inp): D3 is geometry-only, so the SCF density
! is identical in both runs — the force difference isolates pure ATM (C9).
! DIAGONALIZATION (not OT): OT is Gamma-only under &KPOINTS.
!
! Fair wall (1 MPI x fixed OMP, offline only):
!   source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
!   export OMP_NUM_THREADS=8
!   mpirun -np 1 cp2k.psmp -i water_dimer_d3_atm_k_forces.inp \
!          -o water_dimer_d3_atm_k_forces.out
&GLOBAL
  PROJECT water_dimer_d3_atm_k_forces
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      FULL_GRID .FALSE.
      SYMMETRY .FALSE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 80
      EPS_SCF 1.0E-8
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 10.0
          LONG_RANGE_CORRECTION .FALSE.
          CALCULATE_C9_TERM .TRUE.
          VERBOSE_OUTPUT .TRUE.
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
