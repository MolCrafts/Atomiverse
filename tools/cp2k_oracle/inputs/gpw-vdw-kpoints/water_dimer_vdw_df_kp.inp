! CP2K twin for regressions/gpw/gpw-vdw-kpoints — nonlocal vdW-DF (DRSLL)
! on the Monkhorst-Pack k-point path: periodic water dimer (gpw-vdw-df-ice /
! gpw-vdw-multigrid family geometry), PBE + NON_LOCAL DRSLL, CUTOFF 200,
! NGRIDS 4 / REL_CUTOFF 40, &KPOINTS MONKHORST-PACK 2 1 1.
! KPOINTS requires the diagonalization SCF (no OT), same as
! tools/cp2k_oracle/inputs/gpw-multigrid-kpoints/si_kpoints_mg.inp.
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Pins: `ENERGY| Total` and `Dispersion energy` [Ha] ->
! regressions/gpw/gpw-vdw-kpoints/REFERENCE.md.
&GLOBAL
  PROJECT water_dimer_vdw_df_kp
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 60
      EPS_SCF 1.0E-7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE NON_LOCAL
        &NON_LOCAL
          TYPE DRSLL
          KERNEL_FILE_NAME vdW_kernel_table.dat
          SCALE 1.0
        &END NON_LOCAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
