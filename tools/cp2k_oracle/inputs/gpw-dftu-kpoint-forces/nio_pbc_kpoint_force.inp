&GLOBAL
  PROJECT nio_pbc_kpoint_force
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    PLUS_U_METHOD MULLIKEN
    LSD
    MULTIPLICITY 3
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      SYMMETRY OFF
      FULL_GRID OFF
    &END KPOINTS
    &MGRID
      CUTOFF 250
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
      EXTRAPOLATION USE_GUESS
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 300
      ADDED_MOS 8
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MULLIKEN ON
      &END MULLIKEN
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Ni  5.000  5.000  4.100
      O   5.000  5.000  5.900
    &END COORD
    &KIND Ni
      ELEMENT Ni
      BASIS_SET SZV-GTH-PADE-q18
      POTENTIAL GTH-PADE-q18
      MAGNETIZATION 2.0
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 6.0
      &END DFT_PLUS_U
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET SZV-GTH-PADE
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
