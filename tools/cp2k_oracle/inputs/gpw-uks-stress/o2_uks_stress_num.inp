! O2 triplet UKS / PBE / DZVP-MOLOPT-GTH + GTH-PBE-q6 — Γ-only, MT isolated
! STRESS_TENSOR NUMERICAL twin for Atomiverse regressions/gpw/gpw-uks-stress
! Geometry: R(O-O) = 1.2075 Å centered in 12 Å cell (same as gpw-uks-forces)
! Valence: 12 e- (GTH-q6), multiplicity 3 → Nα=7, Nβ=5
! Offline only — never launched from ctest.

&GLOBAL
  PROJECT o2_uks_stress_num
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    CHARGE 0
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &SCF
      MAX_SCF 80
      EPS_SCF 1.0E-7
      SCF_GUESS ATOMIC
      &OT OFF
      &END OT
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MOMENTS OFF
      &END MOMENTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  6.000000  6.000000  5.396250
      O  6.000000  6.000000  6.603750
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
