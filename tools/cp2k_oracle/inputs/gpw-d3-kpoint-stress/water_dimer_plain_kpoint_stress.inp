! Offline CP2K twin for regressions/gpw/gpw-d3-kpoint-stress/ (never launched by ctest).
! Plain-PBE multi-k twin (no VDW block): identical geometry/settings as
! water_dimer_d3_kpoint_stress.inp. Because D3 is geometry-only, the D3-run
! stress minus this run's stress isolates the D3-zero dispersion stress, with
! the electronic (grid-/k-mesh-noise-limited) part cancelling.
!
! Example:
!   source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
!   OMP_NUM_THREADS=1 mpirun -np 1 cp2k.psmp \
!       -i water_dimer_plain_kpoint_stress.inp -o water_dimer_plain_kpoint_stress.out
! Record: total energy, STRESS| NUMERICAL stress tensor, wall time.

&GLOBAL
  PROJECT water_dimer_plain_kpoint_stress
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NUMERICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      FULL_GRID .FALSE.
      SYMMETRY .FALSE.
      VERBOSE .FALSE.
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 80
      EPS_SCF 1.0E-7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
