# CP2K twin for regressions/dynamics/xl-bomd-water (offline oracle — never
# run at ctest/regression time). Same H2O NVE system as h2o_bomd_mt.inp;
# the guess-propagation setting is what differs: CP2K's density-matrix ASPC
# extrapolation (EXTRAPOLATION ASPC, its MD default) is the closest
# input-file analogue of the ATV XL-BOMD auxiliary-density guess. Record the
# EXTRAPOLATION/EXTRAPOLATION_ORDER actually used when pinning, plus the
# conserved-quantity column of the .ener file for the drift envelope.
# NOTE (2026-07-25): no cp2k binary/module on the worker host — unexecuted
# sketch, kept for a future re-pin (see REFERENCE.md).
&GLOBAL
  PROJECT xl_bomd_water_nve
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 5
    TIMESTEP 0.5
    TEMPERATURE 10.0
  &END MD
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      # Density-matrix guess propagation across MD steps (vs ATV XL-BOMD
      # K=5 dissipative recursion; ASPC is Kolafa's predictor-corrector).
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 60
      # Diagonalization/DIIS twin of the ATV xl_bomd path (OT would bypass
      # the density-guess propagation being compared).
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  5.0000  5.0000  5.0000
      H  5.7586  5.0000  5.5043
      H  4.2414  5.0000  5.5043
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &VELOCITY
      O  0.0000  0.0000  0.0000
      H  0.0015  0.0000  0.0000
      H -0.0015  0.0000  0.0000
    &END VELOCITY
  &END SUBSYS
&END FORCE_EVAL
