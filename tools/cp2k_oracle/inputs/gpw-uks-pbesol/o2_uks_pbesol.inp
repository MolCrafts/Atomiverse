! O2 triplet UKS / PBEsol / DZVP-MOLOPT-GTH + GTH-PBE-q6 — Γ-only, MT isolated
! Twin for Atomiverse regressions/gpw/gpw-uks-pbesol
! Geometry: R(O-O) = 1.2075 Å (same as gpw-uks-pbe / gpw-uks-rpbe / …)
! Valence: 12 e- (GTH-q6), multiplicity 3 → Nα=7, Nβ=5
! XC: PBEsol via PARAMETRIZATION PBESOL (GGA_X_PBE_SOL + GGA_C_PBE_SOL)

&GLOBAL
  PROJECT o2_uks_pbesol
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS
    LSD
    MULTIPLICITY 3
    CHARGE 0
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &SCF
      MAX_SCF 80
      EPS_SCF 1.0E-6
      SCF_GUESS ATOMIC
      &OT OFF
      &END OT
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION PBESOL
        &END PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MOMENTS OFF
      &END MOMENTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      ! Centered in the 12 Å cell (MT nonperiodic needs well-contained Gaussians)
      O  6.000000  6.000000  5.396250
      O  6.000000  6.000000  6.603750
    &END COORD
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
