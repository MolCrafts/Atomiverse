! Offline twin for regressions/gpw/periodic-urpa-si (never launched by ctest).
! Γ-point GPW unrestricted RI-RPA on periodic sc-Si2: cubic a=5.43 Å,
! UKS PBE reference with MULTIPLICITY 1 (nα=nβ), DZVP-MOLOPT-GTH +
! GTH-PBE-q4, CUTOFF 30 Ry. LEVEL_SHIFT 0.3 Ha matches the Atomiverse
! product deck (small-gap artificial sc-Si2).
!
! CP2K path is frequency-integrated RI-RPA with Gaussian RI_AUX (not the
! exact plasmon formula on PW-RI (ia|jb) that Atomiverse implements). Use
! the printed RI-RPA *correlation* energy as a near-twin diagnostic;
! Atomiverse dual-gates spectral URPA@UKS E_c against closed-shell dRPA
! (REFERENCE.md).
&GLOBAL
  PROJECT periodic-urpa-si
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UNRESTRICTED_KOHN_SHAM
    MULTIPLICITY 1
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 30
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      MAX_SCF 200
      EPS_SCF 1.0E-6
      SCF_GUESS ATOMIC
      ADDED_MOS 22
      LEVEL_SHIFT 0.3
      ! Small-gap sc-Si2 can stall DIIS; allow RPA on near-converged
      ! orbitals for offline diagnostics only (never ctest).
      IGNORE_CONVERGENCE_FAILURE .TRUE.
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        MEMORY 2000
        NUMBER_PROC 1
        &INTEGRALS
          &WFC_GPW
            CUTOFF 30
            REL_CUTOFF 10
            EPS_FILTER 1.0E-8
            EPS_GRID 1.0E-8
          &END WFC_GPW
        &END INTEGRALS
        &RI_RPA
          MINIMAX
          RPA_NUM_QUAD_POINTS 8
          &HF
            FRACTION 1.0
            &SCREENING
              EPS_SCHWARZ 1.0E-6
              SCREEN_ON_INITIAL_P FALSE
            &END SCREENING
          &END HF
        &END RI_RPA
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.43 5.43 5.43
      PERIODIC XYZ
    &END CELL
    &COORD
      Si 0.000000 0.000000 0.000000
      Si 1.357500 1.357500 1.357500
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      BASIS_SET RI_AUX RI_40_4_4_2_2_0_0_0_4.6e-05
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
