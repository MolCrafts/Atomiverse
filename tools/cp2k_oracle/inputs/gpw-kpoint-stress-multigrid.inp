! CP2K twin for regressions/gpw/rks — Monkhorst-Pack k-point GPW
! stress on diamond Si bct 4-atom (DZVP-MOLOPT-GTH + GTH-PBE-q4, PBE).
! Run OFFLINE only (tools/cp2k_oracle/README.md); never at ctest time.
! Pin: STRESS_TENSOR ANALYTICAL [Ha/Bohr^3] + total energy [Ha].
&GLOBAL
  PROJECT si_kpoint_stress_bct_mg
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 100
      NGRIDS 4
      REL_CUTOFF 40
    &END MGRID
    &QS
      CORE_PPL GRID
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      EPS_PPNL 1.0E-12
      EPS_FILTER_MATRIX 0.0
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-10
      EPS_DIIS 0.0
      MAX_SCF 200
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.839589821842952 3.839589821842952 5.430000000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.50 0.50 0.50
      Si 0.50 0.00 0.25
      Si 0.00 0.50 0.75
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
