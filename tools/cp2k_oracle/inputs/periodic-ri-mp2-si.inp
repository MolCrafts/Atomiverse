! Offline twin for regressions/gpw/periodic-ri-mp2-si (never launched by ctest).
! Γ-point GPW MP2_GPW on periodic sc-Si2: cubic a=5.43 Å, RKS PBE
! reference, DZVP-MOLOPT-GTH + GTH-PBE-q4, CUTOFF 30 Ry. LEVEL_SHIFT 0.3 Ha
! matches the Atomiverse product deck (small-gap artificial sc-Si2).
&GLOBAL
  PROJECT periodic-ri-mp2-si
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 30
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      MAX_SCF 100
      EPS_SCF 1.0E-6
      SCF_GUESS ATOMIC
      ADDED_MOS 22
      LEVEL_SHIFT 0.3
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &WF_CORRELATION
        MEMORY 1000
        NUMBER_PROC 1
        &INTEGRALS
          &WFC_GPW
            CUTOFF 30
            REL_CUTOFF 10
            EPS_FILTER 1.0E-8
            EPS_GRID 1.0E-8
          &END WFC_GPW
        &END INTEGRALS
        &MP2
          METHOD MP2_GPW
        &END MP2
      &END WF_CORRELATION
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.43 5.43 5.43
      PERIODIC XYZ
    &END CELL
    &COORD
      Si 0.000000 0.000000 0.000000
      Si 1.357500 1.357500 1.357500
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
