! Offline CP2K twin note for regressions/pw/periodic-wannier-uks
! (NOT run by ctest — human/agent pin host only).
!
! Diamond Si 2-atom cell, collinear LSD (UKS framework, multiplicity 1 /
! closed shell) + LOCALIZE Wannier centers. GTH + DZVP-MOLOPT is the
! Quickstep path; Atomiverse pin is ONCV plane-wave collinear MLWF.
! Absolute spreads differ; bond-midpoint geometry of the four valence
! MLWFs **per spin channel** at M=0 is the shared content
! (Marzari & Vanderbilt, PRB 56, 12847 (1997)).
!
! &GLOBAL
!   PROJECT si_wannier_uks
!   RUN_TYPE ENERGY
! &END GLOBAL
! &FORCE_EVAL
!   METHOD Quickstep
!   &DFT
!     BASIS_SET_FILE_NAME BASIS_MOLOPT
!     POTENTIAL_FILE_NAME GTH_POTENTIALS
!     LSD
!     MULTIPLICITY 1
!     &QS
!       EPS_DEFAULT 1.0E-12
!     &END QS
!     &SCF
!       SCF_GUESS ATOMIC
!       EPS_SCF 1.0E-7
!       MAX_SCF 50
!     &END SCF
!     &XC
!       &XC_FUNCTIONAL PADE
!       &END XC_FUNCTIONAL
!     &END XC
!     &LOCALIZE
!       METHOD JACOBI
!       MAX_ITER 200
!       EPS_LOCALIZATION 1.0E-8
!     &END LOCALIZE
!     &PRINT
!       &WANNIER_CENTERS
!       &END WANNIER_CENTERS
!     &END PRINT
!   &END DFT
!   &SUBSYS
!     &CELL
!       ABC 5.43 5.43 5.43
!     &END CELL
!     &COORD
!       Si  0.000  0.000  0.000
!       Si  1.3575 1.3575 1.3575
!     &END COORD
!     &KIND Si
!       BASIS_SET DZVP-MOLOPT-SR-GTH
!       POTENTIAL GTH-PADE-q4
!     &END KIND
!   &END SUBSYS
! &END FORCE_EVAL
