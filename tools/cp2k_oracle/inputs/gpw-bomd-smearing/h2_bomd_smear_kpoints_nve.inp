! CP2K twin for regressions/gpw/gpw-bomd-smearing —
! multi-k BOMD NVE with FERMI_DIRAC smear (periodic H2).
! Run OFFLINE only; never at ctest time.

&GLOBAL
  PROJECT h2_bomd_smear_kpoints_nve
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 4
    TIMESTEP 0.5
  &END MD
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      NGRIDS 1
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION USE_PREV_P
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 60
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 3157.75
      &END SMEAR
      ADDED_MOS 4
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 1 1 2
      FULL_GRID .TRUE.
    &END KPOINTS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H  5.5  6.0  6.0
      H  6.5  6.0  6.0
    &END COORD
    &KIND H
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PADE-q1
    &END KIND
    &VELOCITY
      -4.5710290E-05  0.0  0.0
       4.5710290E-05  0.0  0.0
    &END VELOCITY
  &END SUBSYS
&END FORCE_EVAL
