! Offline CP2K twin note for regressions/gpw/periodic-wannier-gpw
! (NOT run by ctest — human/agent pin host only).
!
! Diamond Si BCT 4-atom orthorhombic cell, LOCALIZE Wannier centers.
! GTH-PBE-q4 + DZVP-MOLOPT-GTH matches Atomiverse GPW tables.
! Shared pin: bond-midpoint geometry of the eight valence MLWFs
! (Marzari & Vanderbilt, PRB 56, 12847 (1997)).
!
! &GLOBAL
!   PROJECT si_wannier_gpw
!   RUN_TYPE ENERGY
! &END GLOBAL
! &FORCE_EVAL
!   METHOD Quickstep
!   &DFT
!     BASIS_SET_FILE_NAME BASIS_MOLOPT
!     POTENTIAL_FILE_NAME GTH_POTENTIALS
!     &QS
!       EPS_DEFAULT 1.0E-12
!     &END QS
!     &SCF
!       SCF_GUESS ATOMIC
!       EPS_SCF 1.0E-7
!       MAX_SCF 50
!     &END SCF
!     &XC
!       &XC_FUNCTIONAL PADE
!       &END XC_FUNCTIONAL
!     &END XC
!     &KPOINTS
!       SCHEME MONKHORST-PACK 2 2 2
!     &END KPOINTS
!     &LOCALIZE
!       METHOD JACOBI
!       MAX_ITER 200
!       EPS_LOCALIZATION 1.0E-8
!     &END LOCALIZE
!     &PRINT
!       &WANNIER_CENTERS
!       &END WANNIER_CENTERS
!     &END PRINT
!   &END DFT
!   &SUBSYS
!     &CELL
!       ABC 3.83959 3.83959 5.43
!       PERIODIC XYZ
!     &END CELL
!     &COORD
!       Si  0.00000  0.00000  0.00000
!       Si  1.91980  1.91980  2.71500
!       Si  1.91980  0.00000  1.35750
!       Si  0.00000  1.91980  4.07250
!     &END COORD
!     &KIND Si
!       BASIS_SET DZVP-MOLOPT-SR-GTH
!       POTENTIAL GTH-PBE-q4
!     &END KIND
!   &END SUBSYS
! &END FORCE_EVAL
