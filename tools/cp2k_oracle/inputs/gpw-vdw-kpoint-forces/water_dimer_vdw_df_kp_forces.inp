! Offline CP2K twin for regressions/gpw/gpw-vdw-kpoint-forces/
! Never launched by ctest. Periodic water-dimer GPW PBE + nonlocal
! vdW-DF (DRSLL) + MONKHORST-PACK 2 1 1 + ENERGY_FORCE.
! Same geometry / grid / XC / NON_LOCAL as gpw-vdw-kpoints energy twin
! (water_dimer_vdw_df_kp.inp) with RUN_TYPE ENERGY_FORCE + FORCES print.
! KPOINTS requires DIAGONALIZATION (not OT). Self-consistent V_nl by default.
!
! Fair wall (offline only):
!   source /nobackup/proj/disk/teoroo/personal/jicli594/work/cp2k/install/env.sh
!   OMP_NUM_THREADS=8 mpirun -np 1 cp2k.psmp \
!       -i water_dimer_vdw_df_kp_forces.inp -o water_dimer_vdw_df_kp_forces.out
! Record: ENERGY| Total; Dispersion energy; FORCES| Atomic forces; CP2K wall.
&GLOBAL
  PROJECT water_dimer_vdw_df_kp_forces
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 60
      EPS_SCF 1.0E-7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE NON_LOCAL
        &NON_LOCAL
          TYPE DRSLL
          KERNEL_FILE_NAME vdW_kernel_table.dat
          SCALE 1.0
        &END NON_LOCAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.758602  0.000000  0.504284
      H  0.758602  0.000000 -0.504284
      O  3.000000  0.000000  0.000000
      H  3.758602  0.000000  0.504284
      H  3.758602  0.000000 -0.504284
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
