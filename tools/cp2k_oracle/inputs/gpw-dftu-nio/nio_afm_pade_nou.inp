&GLOBAL
  PROJECT nio_afm_nou
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    LSD
    MULTIPLICITY 1
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART
          BACKUP_COPIES 0
          FILENAME =nio_wfn
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.17 4.17 8.34
      PERIODIC XYZ
    &END CELL
    &COORD
      Ni_u  0.000  0.000  0.000
      O     2.085  2.085  2.085
      Ni_d  0.000  0.000  4.170
      O     2.085  2.085  6.255
    &END COORD
    &KIND Ni_u
      ELEMENT Ni
      BASIS_SET SZV-GTH-PADE-q18
      POTENTIAL GTH-PADE-q18
      MAGNETIZATION 2.0
    &END KIND
    &KIND Ni_d
      ELEMENT Ni
      BASIS_SET SZV-GTH-PADE-q18
      POTENTIAL GTH-PADE-q18
      MAGNETIZATION -2.0
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET SZV-GTH-PADE
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
