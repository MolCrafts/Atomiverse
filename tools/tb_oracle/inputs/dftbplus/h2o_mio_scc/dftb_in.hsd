Geometry = GenFormat {
  <<< "geo.gen"
}

Hamiltonian = DFTB {
  SCC = Yes
  SCCTolerance = 1e-10
  MaxSCCIterations = 100
  MaxAngularMomentum = {
    O = "p"
    H = "s"
  }
  SlaterKosterFiles = Type2FileNames {
    Prefix = "./"
    Separator = "-"
    Suffix = ".skf"
  }
}

Options = {
  WriteDetailedOut = Yes
  WriteResultsTag = Yes
}

ParserOptions = {
  ParserVersion = 12
}
