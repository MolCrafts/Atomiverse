# Offline DFTB+ 24.1 twin for ATV slug dftb2-spin-analytic-stress.
# Cluster O2 triplet, tilted bond |R|=1.30 Å along (0.6, 0.7, sqrt(0.15)),
# matching regressions/semiempirical/dftb2-spin-analytic-stress/. ATV uses
# DftbBoundary::cluster with a cubic 20 Å box only to define Ω for the
# intensive virial — that is still a cluster Hamiltonian. A DFTB+ `S`
# geometry would add Ewald images ATV does not use, so this twin stays `C`.
# Cluster DFTB+ has no cell, so it cannot report stress; energy + forces
# are the archived quantities. Same spin block as spin-dftb2-o2.
Geometry = GenFormat {
  <<< "geo.gen"
}

Driver = {}

Hamiltonian = DFTB {
  SCC = Yes
  SCCTolerance = 1e-12
  MaxSCCIterations = 200
  MaxAngularMomentum = {
    O = "p"
  }
  SlaterKosterFiles = Type2FileNames {
    Prefix = "./"
    Separator = "-"
    Suffix = ".skf"
  }
  SpinPolarisation = Colinear {
    UnpairedElectrons = 2
    RelaxTotalSpin = No
  }
  SpinConstants = {
    ShellResolvedSpin = No
    O = { -0.028 }
  }
}

Analysis = {
  PrintForces = Yes
}

Options = {
  WriteDetailedOut = Yes
  WriteResultsTag = Yes
}

ParserOptions = {
  ParserVersion = 12
}
