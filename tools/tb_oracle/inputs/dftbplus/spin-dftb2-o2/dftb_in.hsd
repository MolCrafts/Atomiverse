# Offline DFTB+ 24.1 twin for ATV slug spin-dftb2-o2.
# Cluster O2 triplet, r=1.21 Å, matching regressions/semiempirical/spin-dftb2-o2/.
# PBE spin table (DFTB+ manual app:spinconst): O = {-0.035, -0.030, -0.030, -0.028} Ha
# (ss, sp, ps, pp; l' fastest). DFTB+ ShellResolvedSpin = No accepts a single
# constant and fills W_ll' with it; ATV's HOAO collapse uses W_pp, so the
# matching input is -0.028 Ha. Prefix is rewritten by run_dftbplus_pin.sh.
Geometry = GenFormat {
  <<< "geo.gen"
}

Driver = {}

Hamiltonian = DFTB {
  SCC = Yes
  SCCTolerance = 1e-10
  MaxSCCIterations = 100
  MaxAngularMomentum = {
    O = "p"
  }
  SlaterKosterFiles = Type2FileNames {
    Prefix = "./"
    Separator = "-"
    Suffix = ".skf"
  }
  SpinPolarisation = Colinear {
    UnpairedElectrons = 2
    RelaxTotalSpin = No
  }
  SpinConstants = {
    ShellResolvedSpin = No
    O = { -0.028 }
  }
}

Options = {
  WriteDetailedOut = Yes
  WriteResultsTag = Yes
}

ParserOptions = {
  ParserVersion = 12
}
