# Short-run variant of amorphous.in for MPI scaling benchmarks.
# Stage 1: 1000 steps @ 1.0 fs, Stage 2: 2000 steps @ 0.5 fs — matches the
# Atomiverse run.sh --short path so both codes do identical work. All
# force-field / integrator / neighbor settings are copied verbatim from
# the full amorphous.in; only `run` counts changed.

variable fname   index PE_nc10_cl1000.dat
variable simname index PE_nc10_cl1000

units       real
boundary    p p p
atom_style  molecular
read_data   ${fname}

neighbor        0.4 bin
neigh_modify    every 10 one 10000
bond_style      harmonic
bond_coeff      1 350 1.53
angle_style     harmonic
angle_coeff     1 60 109.5
dihedral_style  multi/harmonic
dihedral_coeff  1 1.73 -4.49 0.776 6.99 0.0
pair_style      lj/cut 10.5
pair_coeff      1 1 0.112 4.01 10.5

velocity   all create 500.0 1231
fix        1 all nve/limit 0.05
fix        2 all langevin 500.0 500.0 10.0 904297
thermo_style custom step temp press pe ke etotal density vol lx ly lz
thermo     100
timestep   1.0
run        1000
unfix 1
unfix 2

fix        1 all npt temp 500.0 500.0 50 iso 0 0 1000 drag 2
fix        2 all momentum 1 linear 1 1 1
thermo_style custom step temp press pe ke etotal density vol lx ly lz
thermo     100
timestep   0.5
reset_timestep 0
run        2000
unfix 1
unfix 2
