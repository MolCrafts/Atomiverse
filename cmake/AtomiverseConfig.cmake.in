@PACKAGE_INIT@
set(_Atomiverse_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(_Atomiverse_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(Atomiverse_HF_FOUND @ATV_BUILD_HF@)
set(Atomiverse_PW_FOUND @ATV_BUILD_PW@)
set(Atomiverse_GPW_FOUND @ATV_BUILD_GPW@)
set(Atomiverse_SEMIEMPIRICAL_FOUND @ATV_BUILD_SEMIEMPIRICAL@)
set(Atomiverse_EVALUATE_FOUND @ATV_BUILD_EVALUATE@)
set(Atomiverse_MD_FOUND @ATV_BUILD_MD@)
set(Atomiverse_MINIMIZER_FOUND @ATV_BUILD_MINIMIZER@)
set(Atomiverse_VIB_FOUND @ATV_BUILD_VIB@)
set(Atomiverse_CUDA_FOUND @ATV_BUILD_CUDA@)
set(Atomiverse_KSPACE_FOUND @ATV_BUILD_KSPACE@)
set(Atomiverse_MC_FOUND @ATV_BUILD_MC@)
set(Atomiverse_PATH_FOUND @ATV_BUILD_PATH@)
set(Atomiverse_ANALYSIS_FOUND @ATV_BUILD_ANALYSIS@)
set(Atomiverse_IO_FOUND @ATV_BUILD_IO@)
include(CMakeFindDependencyMacro)
find_dependency(xtl 0.8.2 CONFIG)
find_dependency(xtensor 0.27.1 CONFIG)
find_dependency(xtensor-blas 0.23.0 CONFIG)
find_dependency(xsimd 14.3.0 CONFIG)
find_dependency(spdlog 1.17.0 CONFIG)
find_dependency(BLAS)
find_dependency(LAPACK)

if(@OpenMP_CXX_FOUND@)
    if(APPLE AND NOT TARGET OpenMP::OpenMP_CXX)
        find_library(OpenMP_omp_LIBRARY omp PATHS /opt/homebrew/opt/libomp/lib)
        find_path(OpenMP_CXX_INCLUDE_DIR omp.h PATHS /opt/homebrew/opt/libomp/include)
        if(OpenMP_omp_LIBRARY)
            set(OpenMP_CXX_FLAGS "-Xpreprocessor -fopenmp")
            set(OpenMP_CXX_LIB_NAMES omp)
        endif()
    endif()
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@ATV_USE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif()
if(@ATV_BUILD_CUDA@)
    find_dependency(CUDAToolkit)
endif()
if(@ATV_BUILD_GPW@)
    find_dependency(ZLIB)
endif()

if(@ATV_BUILD_MOLPY@ AND NOT TARGET Atomiverse::molpy_cxx)
    add_library(Atomiverse::molpy_cxx STATIC IMPORTED)
    set_target_properties(Atomiverse::molpy_cxx PROPERTIES
        IMPORTED_LOCATION "${_Atomiverse_LIBRARY_DIR}/@CMAKE_STATIC_LIBRARY_PREFIX@molpy_cxx@CMAKE_STATIC_LIBRARY_SUFFIX@"
        INTERFACE_INCLUDE_DIRECTORIES "${_Atomiverse_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "Atomiverse::molpy_runtime")
    add_library(Atomiverse::molpy_runtime STATIC IMPORTED)
    set_target_properties(Atomiverse::molpy_runtime PROPERTIES
        IMPORTED_LOCATION "${_Atomiverse_LIBRARY_DIR}/@CMAKE_STATIC_LIBRARY_PREFIX@molcxx@CMAKE_STATIC_LIBRARY_SUFFIX@"
        INTERFACE_LINK_LIBRARIES "@Rust_CARGO_TARGET_LINK_NATIVE_LIBS@"
        INTERFACE_LINK_OPTIONS "@Rust_CARGO_TARGET_LINK_OPTIONS@")
endif()

if(@ATV_BUILD_PW@ OR @ATV_BUILD_KSPACE@)
    find_path(Atomiverse_FFTW_INCLUDE_DIR fftw3.h REQUIRED)
    find_library(Atomiverse_FFTW_LIBRARY NAMES fftw3 REQUIRED)
    if(NOT TARGET Atomiverse::fftw)
        add_library(Atomiverse::fftw INTERFACE IMPORTED)
        set_target_properties(Atomiverse::fftw PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${Atomiverse_FFTW_INCLUDE_DIR}"
            INTERFACE_LINK_LIBRARIES "${Atomiverse_FFTW_LIBRARY}")
    endif()
endif()
if(@ATV_PACKAGE_FFTW_OMP@)
    find_library(Atomiverse_FFTW_OMP_LIBRARY NAMES fftw3_omp REQUIRED)
    if(NOT TARGET Atomiverse::fftw_omp)
        add_library(Atomiverse::fftw_omp INTERFACE IMPORTED)
        set_target_properties(Atomiverse::fftw_omp PROPERTIES
            INTERFACE_LINK_LIBRARIES "${Atomiverse_FFTW_OMP_LIBRARY};OpenMP::OpenMP_CXX")
    endif()
endif()
if(@ATV_PACKAGE_FFTW_MPI@)
    find_library(Atomiverse_FFTW_MPI_LIBRARY NAMES fftw3_mpi REQUIRED)
    if(NOT TARGET Atomiverse::fftw_mpi)
        add_library(Atomiverse::fftw_mpi INTERFACE IMPORTED)
        set_target_properties(Atomiverse::fftw_mpi PROPERTIES
            INTERFACE_LINK_LIBRARIES "${Atomiverse_FFTW_MPI_LIBRARY}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AtomiverseTargets.cmake")
check_required_components(Atomiverse)
