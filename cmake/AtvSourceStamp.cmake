# Source revision of the tree being built, as a C header. Script mode:
#
#   cmake -DSOURCE_DIR=<checkout> -DOUTPUT=<header> -P AtvSourceStamp.cmake
#
# The build runs it on every build (target `atv_source_stamp`); the header is
# rewritten only when its content changes, so an unchanged revision rebuilds
# nothing. It defines
#
#   ATV_SOURCE_COMMIT  "<40-hex commit>" or "unknown"
#   ATV_SOURCE_DIRTY   1 tracked files differ from that commit, 0 they do
#                      not, -1 unknown
#
# Where the revision comes from, first match wins:
#
# 1. SOURCE_DIR is a git checkout (`.git` directory or worktree file):
#    `git rev-parse HEAD`, dirty when `git status` lists a tracked change.
# 2. SOURCE_DIR/.atv-source-commit exists: a tree copied without `.git`
#    (rsync, git archive) carries its revision in this file, written by
#    whoever copied it, one line `<40-hex commit> clean|dirty`:
#
#      printf '%s %s\n' "$(git rev-parse HEAD)" \
#        "$(git status --porcelain --untracked-files=no | grep -q . \
#           && echo dirty || echo clean)" > <copy>/.atv-source-commit
#
#    A malformed file fails the build.
# 3. Neither: "unknown".

if(NOT SOURCE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "AtvSourceStamp: pass -DSOURCE_DIR=... -DOUTPUT=...")
endif()

set(_commit "unknown")
set(_dirty -1)
set(_stamp_file "${SOURCE_DIR}/.atv-source-commit")

if(EXISTS "${SOURCE_DIR}/.git")
    find_program(_git git REQUIRED)
    execute_process(
        COMMAND "${_git}" -C "${SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE _commit ERROR_VARIABLE _err RESULT_VARIABLE _rc
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR
            "AtvSourceStamp: git rev-parse HEAD failed in ${SOURCE_DIR}: "
            "${_err}")
    endif()
    # No optional locks: a concurrent `git commit` must not see index.lock.
    execute_process(
        COMMAND "${_git}" --no-optional-locks -C "${SOURCE_DIR}" status
                --porcelain --untracked-files=no
        OUTPUT_VARIABLE _changes ERROR_VARIABLE _err RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR
            "AtvSourceStamp: git status failed in ${SOURCE_DIR}: ${_err}")
    endif()
    if(_changes STREQUAL "")
        set(_dirty 0)
    else()
        set(_dirty 1)
    endif()
elseif(EXISTS "${_stamp_file}")
    file(READ "${_stamp_file}" _line)
    string(STRIP "${_line}" _line)
    if(NOT _line MATCHES "^([0-9a-f]+) (clean|dirty)$")
        message(FATAL_ERROR
            "AtvSourceStamp: ${_stamp_file} must hold one line "
            "'<40-hex commit> clean|dirty', got '${_line}'")
    endif()
    set(_commit "${CMAKE_MATCH_1}")
    set(_state "${CMAKE_MATCH_2}")
    string(LENGTH "${_commit}" _len)
    if(NOT _len EQUAL 40)
        message(FATAL_ERROR
            "AtvSourceStamp: ${_stamp_file} names '${_commit}', not a full "
            "40-hex commit")
    endif()
    if(_state STREQUAL "dirty")
        set(_dirty 1)
    else()
        set(_dirty 0)
    endif()
endif()

set(_header "// Generated by cmake/AtvSourceStamp.cmake; do not edit.
#pragma once
#define ATV_SOURCE_COMMIT \"${_commit}\"
#define ATV_SOURCE_DIRTY ${_dirty}
")
file(WRITE "${OUTPUT}.tmp" "${_header}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
